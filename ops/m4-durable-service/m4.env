# Reviewed M4 durable-service parameters. Keep values absolute and credential-free.
SERVICE_USER=ai
SERVICE_GROUP=ai
SERVICE_UID=1000
BROKER_BIN=/home/ai/.local/bin/agent-manager-broker
CLAUDE_PYTHON=/home/ai/.local/share/agent-manager/venv/bin/python
UNIT_NAME=agent-manager-broker.service
UNIT_TARGET=/home/ai/.config/systemd/user/agent-manager-broker.service
STATUS_DIR=/var/lib/zemrip/status
STATUS_FILE=/var/lib/zemrip/status/agent-manager.json
VERIFY_FILE=/var/lib/zemrip/status/agent-manager-m4-verify.json
SOCKET_PATH=/run/user/1000/agent-manager/broker.sock
REGISTRY_PATH=/home/ai/.local/state/agent-manager/registry.json
